{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://showgate-production.up.railway.app/api/:path*"
    },
    {
      "source": "/e/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawl|spider|facebookexternalhit|whatsapp|telegram|slack|discord|twitter|linkedin|preview|embed|skype|pinterest|imessage|applebot).*"
        }
      ],
      "destination": "https://showgate-production.up.railway.app/og/e/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
